<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
  <div class="col-8 offset-3">
    <h2>Listing Details</h2>
  </div>
  <div class="card col-6 offset-3 show-card">
    <img
      src="<%= listing.image.url%>"
      class="card-img-top show-img"
      alt="listing_image"
    />
    <div class="card-body">
      <p class="card-text">
        <%= listing.title %> <br />
        <%= listing.description %> <br />
        &#8377; <%=listing.price.toLocaleString("en-IN") %> <br />
        <%= listing.location %> <br />
        <%=listing.country %> <br />
      </p>
    </div>
  </div>
</div>
<div class="btns">
  <a
    href="/listing/<%= listing._id %>/edit"
    class="btn btn-dark col-1 offset-3 edit-btn"
    >Edit</a
  >
  <form action="/listing/<%= listing._id %>/?_method=DELETE" method="POST">
    <button class="btn btn-dark offset-5">Delete</button>
  </form>
</div>
<div class="mb-3 mt-3">
  <h3>Add a Review</h3>
  <form action="/listing/<%= listing.id %>/reviews" method="post"></form>
  <div>
    <label for="rating">Rating</label>
    <input
      type="range"
      min="1"
      max="5"
      name="review[rating]"
      id="rating"
      class="form-range"
    />
  </div>
  <div class="mb-3 mt-3 mb-3">
    <label for="comment">Comments</label>
    <textarea
      name="review[comment]"
      id="comment"
      cols="30"
      rows="5"
      class="form-control"
    ></textarea>
  </div>
  <div>
    <button class="btn outline-button-dark">Submit</button>
  </div>
</div>
